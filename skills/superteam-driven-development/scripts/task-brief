#!/usr/bin/env bash
# Extract one task's full text from an implementation plan.
#
# Usage: task-brief --print PLAN_FILE TASK_NUMBER
#        task-brief --taskcreate PLAN_FILE TASK_NUMBER implement|review-spec|review-standards|merge [LANE]
#        task-brief PLAN_FILE TASK_NUMBER [OUTFILE]
#
# --taskcreate emits a ready-to-paste TaskCreate subject (line 1) and
# description (from line 3) for one node of the task graph: the implement,
# review-spec, review-standards or merge task for plan task N. Review is two
# axes from the same reviewer.md, run in parallel and never reranked against
# each other, so there is no single "review" kind. The subject's [role] tag carries the
# role and the pool's model is set at spawn, so the body has no Role:/Model:
# line.
#
# --print writes the task text to stdout instead of a file. Use this for a
# worktree implementer: the file-mode OUTFILE lives under the lead's
# gitignored .superteam/ workspace, which does not exist inside the IC's
# worktree and is refused by Claude Code's worktree guard even as an
# absolute path back into the shared checkout. Printing lets the lead paste
# the task text straight into the dispatch prompt instead.
#
# The emitted lines follow the task's isolation tier (its `**Isolation:**`
# line, default trunk): trunk emits `Trunk: <lane>` and no `Branch:` or
# `Worktree:` line, and has no review or merge task — a review seat means
# branch tier. branch emits `Branch: task-N` and no `Worktree:` line, reviews
# the branch `task-N`, and has no merge task — the lead merges. worktree and
# provisioned emit the `Worktree:` line and review `worktree-task-N-impl`.
# Any other value is refused (exit 5).
#
# File mode is unchanged, for reviewers and other teammates that run in the
# lead's own checkout and can read a path there.
# Default OUTFILE: <repo-root>/.superteam/sdd/<plan-basename>/task-<N>-brief.md
# (per plan and per worktree; concurrent runs of the SAME plan in the same
# working tree share it).
set -euo pipefail

if [ "${1:-}" = "--taskcreate" ]; then
  shift
  if [ $# -lt 3 ] || [ $# -gt 4 ]; then
    echo "usage: task-brief --taskcreate PLAN_FILE TASK_NUMBER implement|review-spec|review-standards|merge [LANE]" >&2
    exit 2
  fi
  plan=$1
  n=$2
  kind=$3
  if [ $# -eq 4 ]; then
    lane=$4
  else
    lane=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)
  fi
  [ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }
  case "$kind" in
    implement|review-spec|review-standards|merge) ;;
    review)
      echo "usage: task-brief --taskcreate PLAN_FILE TASK_NUMBER implement|review-spec|review-standards|merge [LANE]" >&2
      echo "review is two axes: review-spec (vs the plan task and spec) and review-standards (vs the repo's standards files)" >&2
      exit 3 ;;
    *) echo "kind must be implement, review-spec, review-standards or merge" >&2; exit 2 ;;
  esac

  brief=$(awk -v n="$n" '
    /^```/ { infence = !infence }
    !infence && /^#+[ \t]/ {
      hashes = $0; sub(/[^#].*/, "", hashes); level = length(hashes)
      if ($0 ~ ("^#+[ \t]+Task[ \t]+" n "([^0-9]|$)")) {
        intask = 1; tasklevel = level
      } else if (intask && (level <= tasklevel || $0 ~ /^#+[ \t]+Task[ \t]+[0-9]+/)) {
        intask = 0
      }
    }
    intask { print }
  ' "$plan")
  [ -n "$brief" ] || { echo "task ${n} not found in ${plan}" >&2; exit 3; }

  constraints=$(awk '
    /^## Global Constraints/ { on = 1; next }
    on && /^(## |---)/ { exit }
    on { print }
  ' "$plan")

  owned=$(printf '%s\n' "$brief" | sed -n 's/^\*\*Files owned:\*\*[[:space:]]*//p' | head -1 | tr -d '`')
  deps=$(printf '%s\n' "$brief" | sed -n 's/^\*\*Depends on:\*\*[[:space:]]*//p' | head -1 | tr -d '`')
  [ -n "$deps" ] || deps=none
  tier=$(printf '%s\n' "$brief" | sed -n 's/^\*\*Model tier:\*\*[[:space:]]*//p' | head -1)
  role=implementer
  if printf '%s' "$tier" | grep -qw prose; then
    role=writer
  fi
  spec=$(sed -n 's/^\*\*Spec:\*\*[[:space:]]*//p' "$plan" | head -1 | tr -d '`')
  [ -n "$spec" ] || spec=none
  base=$(basename "$plan" .md)
  wt="task-${n}-impl"

  # The task's isolation tier, chosen at intake. A task with no line is trunk
  # tier — the default: the seat commits straight on the lane in the lead's
  # own checkout, so there is nothing to review a branch of and nothing to
  # merge. provisioned is the worktree tier plus the repo's own provisioning
  # script, so it emits the worktree lines unchanged.
  iso=$(printf '%s\n' "$brief" | sed -n 's/^\*\*Isolation:\*\*[[:space:]]*//p' | head -1 | tr -d '`')
  [ -n "$iso" ] || iso=trunk
  case "$iso" in
    trunk)                seat=trunk ;;
    branch)               seat=branch ;;
    worktree|provisioned) seat=worktree ;;
    *) echo "Isolation must be trunk, branch, worktree or provisioned (got: ${iso})" >&2; exit 5 ;;
  esac
  if [ "$seat" = trunk ]; then
    case "$kind" in
      review-spec|review-standards|merge)
        echo "trunk tier has no ${kind} task; a review seat means branch tier" >&2
        exit 4 ;;
    esac
  fi
  if [ "$seat" = branch ] && [ "$kind" = merge ]; then
    echo "branch tier has no merge task; the lead merges task-${n}" >&2
    exit 4
  fi
  trunk_line="Trunk: ${lane}        (commit straight on it in the lead's checkout)"
  branch_line="Branch: task-${n}        (git switch -c in the lead's checkout, from Lane)"
  if [ "$seat" = branch ]; then
    reviews="task-${n}"
  else
    reviews="worktree-${wt}"
  fi

  # The repo's standards files, resolved once per plan: the well-known names
  # that exist at the repo root, plus every path on a "**Standards:**" line in
  # the plan header. The implementer and the standards review axis both read
  # this list; the spec axis never does. Cached in the plan's workspace so
  # every task of one plan cites the same files (recomputed if absent).
  cache_dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan" 2>/dev/null || true)
  standards=""
  if [ -n "$cache_dir" ] && [ -f "$cache_dir/standards" ]; then
    standards=$(cat "$cache_dir/standards")
  fi
  if [ -z "$standards" ]; then
    root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
    for s in CONTRIBUTING.md CODING_STANDARDS.md CLAUDE.md AGENTS.md; do
      [ -f "$root/$s" ] || continue
      standards="${standards:+$standards, }$s"
    done
    plan_standards=$(sed -n 's/^\*\*Standards:\*\*[[:space:]]*//p' "$plan" | head -1 | tr -d '`' | tr ',' ' ')
    for s in $plan_standards; do
      case ", $standards, " in *", $s, "*) continue ;; esac
      standards="${standards:+$standards, }$s"
    done
    [ -n "$standards" ] || standards=none
    [ -n "$cache_dir" ] && printf '%s\n' "$standards" > "$cache_dir/standards" 2>/dev/null || true
  fi

  case "$kind" in
    implement)
      echo "Subject: Task ${n}: implement [${role}]"
      echo
      ;;
    review-spec)
      echo "Subject: Task ${n}: review spec [reviewer]"
      echo
      echo "Reviews: ${reviews}"
      echo "Rubric: skills/superteam-driven-development/task-reviewer-prompt.md"
      ;;
    review-standards)
      echo "Subject: Task ${n}: review standards [reviewer]"
      echo
      echo "Reviews: ${reviews}"
      echo "Rubric: skills/superteam-driven-development/task-standards-prompt.md"
      ;;
    merge)
      echo "Subject: Task ${n}: merge [integrator]"
      echo
      echo "Merge: worktree-${wt} → ${lane}"
      ;;
  esac
  echo "Plan: ${plan}   Spec: ${spec}"
  echo "Lane: ${lane}"
  echo "Isolation: ${iso}"
  if [ "$seat" = trunk ]; then
    echo "$trunk_line"
  elif [ "$seat" = branch ]; then
    echo "$branch_line"
  else
    echo "Worktree: ${wt}        (EnterWorktree name; branch worktree-${wt})"
  fi
  echo "Files owned: ${owned}"
  echo "Depends on: ${deps}"
  case "$kind" in
    implement|review-standards) echo "Standards: ${standards}" ;;
  esac
  case "$kind" in
    implement)        echo "Done: report at .superteam/sdd/${base}/task-${n}-report.md with a \`Tests:\` line" ;;
    review-spec)      echo "Done: verdict in .superteam/sdd/${base}/task-${n}-review-spec.md with a \`Verified:\` line" ;;
    review-standards) echo "Done: verdict in .superteam/sdd/${base}/task-${n}-review-standards.md with a \`Verified:\` line" ;;
    merge)            echo "Done: merge sha of worktree-${wt} into ${lane} with a \`Tests:\` line from the full suite" ;;
  esac
  echo "## Task Brief"
  printf '%s\n' "$brief"
  echo "## Global Constraints"
  printf '%s\n' "$constraints"
  exit 0
fi

print_mode=false
if [ "${1:-}" = "--print" ]; then
  print_mode=true
  shift
fi

if [ $# -lt 2 ] || [ $# -gt 3 ] || { [ "$print_mode" = true ] && [ $# -ne 2 ]; }; then
  echo "usage: task-brief --print PLAN_FILE TASK_NUMBER" >&2
  echo "       task-brief --taskcreate PLAN_FILE TASK_NUMBER implement|review-spec|review-standards|merge [LANE]" >&2
  echo "       task-brief PLAN_FILE TASK_NUMBER [OUTFILE]" >&2
  exit 2
fi

plan=$1
n=$2
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

if [ "$print_mode" = true ]; then
  out=$(mktemp)
  trap 'rm -f "$out"' EXIT
elif [ $# -eq 3 ]; then
  out=$3
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  out="$dir/task-${n}-brief.md"
fi

# A task block ends at the next heading of the same or higher level, whatever
# its text — otherwise the last task swallows a trailing "## Finish" section.
awk -v n="$n" '
  /^```/ { infence = !infence }
  !infence && /^#+[ \t]/ {
    hashes = $0; sub(/[^#].*/, "", hashes); level = length(hashes)
    if ($0 ~ ("^#+[ \t]+Task[ \t]+" n "([^0-9]|$)")) {
      intask = 1; tasklevel = level
    } else if (intask && (level <= tasklevel || $0 ~ /^#+[ \t]+Task[ \t]+[0-9]+/)) {
      intask = 0
    }
  }
  intask { print }
' "$plan" > "$out"

if [ ! -s "$out" ]; then
  echo "task ${n} not found in ${plan} (no heading matching 'Task ${n}')" >&2
  exit 3
fi

if [ "$print_mode" = true ]; then
  cat "$out"
else
  echo "wrote ${out}: $(wc -l < "$out" | tr -d ' ') lines"
fi
