#!/usr/bin/env bash
# TaskCompleted hook for superteam plugin. Wired into hooks/hooks.json, so
# it runs automatically on every TaskCompleted event -- both triggers the
# docs name (a TaskUpdate call marking a task completed, and a teammate
# finishing its turn with in-progress tasks) send the same payload shape,
# so no special-casing is needed between them.
#
# Scope: only gates SDD (superteam-driven-development) tasks, never a
# PM's own coordination list or any other task list. A task counts as SDD
# when task_subject matches ^Task [0-9]+: (the subject format
# superteam-driven-development's Ledger section prescribes) or
# task_description contains ".superteam/sdd/". Everything else: exit 0
# immediately, no gate at all.
#
# For an SDD task, refuses completion (exit 2) unless there is
# verification evidence:
#   (a) task_description contains a line starting with "Verified:" or
#       "Evidence:", or
#   (b) the completing agent's report file at
#       ${cwd}/.superteam/sdd/*/task-<N>-report.md (N = the numeric part of
#       task_id, e.g. "4" or "task-004") contains a "Tests:", "Verified:" or
#       "Evidence:" line with a non-empty value.
#
# Payload fields (per Claude Code hooks docs): task_id, task_subject,
# optional task_description, teammate_name, team_name, plus the common
# fields cwd and transcript_path.
#
# Never exits non-zero for malformed/unparseable input, and never exits
# non-zero for a non-SDD task -- only exit 2 when we can positively
# identify an SDD task with no evidence.

usage() {
    cat <<'EOF'
Usage: task-completed-verify
TaskCompleted hook: blocks task completion (exit 2) unless there is
verification evidence in task_description or the task's report file.
Reads the TaskCompleted JSON payload from stdin.
Set SUPERTEAM_SKIP_VERIFY_GATE=1 to bypass this gate.
EOF
}

if [ "${1:-}" = "--help" ]; then
    usage
    exit 0
fi

if [ "${SUPERTEAM_SKIP_VERIFY_GATE:-}" = "1" ]; then
    exit 0
fi

input="$(cat 2>/dev/null || true)"

# Placeholder for an escaped quote (\") inside a JSON string value. BSD
# sed's BRE has no alternation, so [^"]* stops at the first escaped quote
# and truncates the value -- a "Verified:" line after any quoted word in
# the description was invisible. Swapping \" for a control character that
# cannot appear in JSON text keeps the whole value; json_unescape puts it
# back.
JSON_ESCQ="$(printf '\001')"

# Extract a JSON string field's raw (still-escaped) value from a
# single-line-collapsed JSON blob. Tolerates pretty-printed (multi-line)
# JSON since we collapse newlines to spaces first.
json_field() {
    printf '%s' "$1" | tr '\n' ' ' | sed "s/\\\\\"/$JSON_ESCQ/g" | \
        sed -n 's/.*"'"$2"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | \
        head -1
}

# Unescape the common JSON escapes so line-based grep works on the value.
json_unescape() {
    printf '%s' "$1" | sed -e 's/\\n/\
/g' -e 's/\\"/"/g' -e 's/\\\\/\\/g' -e "s/$JSON_ESCQ/\"/g"
}

task_id="$(json_field "$input" "task_id")"

# No parseable task_id -- malformed/unrelated input. Fail open silently.
if [ -z "$task_id" ]; then
    exit 0
fi

task_subject="$(json_unescape "$(json_field "$input" "task_subject")")"
task_description="$(json_unescape "$(json_field "$input" "task_description")")"

# Not an SDD task -- never gate a PM's own coordination list or any other
# task list. Only superteam-driven-development tasks are scoped here.
if ! printf '%s' "$task_subject" | grep -qE '^Task [0-9]+:' \
    && ! printf '%s' "$task_description" | grep -qF '.superteam/sdd/'; then
    exit 0
fi

if printf '%s\n' "$task_description" | grep -qE '^(Verified|Evidence):'; then
    exit 0
fi

cwd="$(json_unescape "$(json_field "$input" "cwd")")"
[ -n "$cwd" ] || cwd="$PWD"

# Numeric part of task_id: "4" -> "4", "task-004" -> "004" (also try the
# leading-zero-stripped form so both naming conventions match a report
# named task-4-report.md or task-004-report.md).
# The plan number in the subject wins over the list id: once review and
# merge tasks exist, list ids and plan numbers diverge (task_id 17 can be
# "Task 4: review", whose report is task-4-report.md).
subj_n="$(printf '%s' "$task_subject" | sed -n 's/^Task \([0-9]*\):.*/\1/p')"
digits="$(printf '%s' "$task_id" | sed 's/[^0-9]//g')"
digits_stripped="$(printf '%s' "$digits" | sed 's/^0*//')"
[ -n "$digits_stripped" ] || digits_stripped="0"

report_found=""
if [ -n "$digits" ] || [ -n "$subj_n" ]; then
    shopt -s nullglob
    for n in "$subj_n" "$digits" "$digits_stripped"; do
        [ -n "$n" ] || continue
        for f in "$cwd"/.superteam/sdd/*/task-"$n"-report.md; do
            [ -f "$f" ] || continue
            if grep -qE '^(Tests|Verified|Evidence):[[:space:]]*[^[:space:]]' "$f"; then
                report_found="$f"
                break 2
            fi
        done
    done
    shopt -u nullglob
fi

if [ -n "$report_found" ]; then
    exit 0
fi

# TaskCompleted also fires when a teammate ends a turn with an in-progress
# task, so an unchanged rejection can repeat every turn (seen live: ~30 times
# for one teammate waiting on its lead). Remember the rejected state and say
# it once. The state key changes whenever the description changes, so real
# progress always gets the full feedback again. Never exit 0 without
# evidence: a repeat is still a rejection, just a quieter one.
teammate_name="$(json_unescape "$(json_field "$input" "teammate_name")")"
team_name="$(json_unescape "$(json_field "$input" "team_name")")"
tasks_dir="${SUPERTEAM_TASKS_DIR:-$HOME/.claude/tasks/${CLAUDE_CODE_TASK_LIST_ID:-$team_name}}"
state_key="$(printf '%s-%s-%s' \
    "$(printf '%s' "${teammate_name:-none}" | tr -c 'A-Za-z0-9_.-' '_')" \
    "$(printf '%s' "$task_id" | tr -c 'A-Za-z0-9_.-' '_')" \
    "$(printf '%s' "$task_description" | cksum | tr -d ' ')")"
marker="$tasks_dir/.gate/$state_key"

if [ -f "$marker" ]; then
    echo "Gate already rejected this state. If you are waiting on the lead, run TaskUpdate status=pending (keep owner) and end your turn; otherwise add the Verified: line." >&2
    exit 2
fi
mkdir -p "$tasks_dir/.gate" 2>/dev/null && : > "$marker" 2>/dev/null

echo "No verification evidence for this task: add a 'Verified: <what you ran>' or 'Evidence: <what you ran>' line to the task description, or a 'Tests:'/'Verified:'/'Evidence:' line with a value to \${cwd}/.superteam/sdd/*/task-${digits:-N}-report.md." >&2
exit 2
