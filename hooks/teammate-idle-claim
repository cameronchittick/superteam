#!/usr/bin/env bash
# TeammateIdle hook for superteam. Role-aware: derives the idle teammate's
# role from the team config member's agentType ("superteam:<role>") at
# ${SUPERTEAM_TEAMS_DIR:-~/.claude/teams}/<team_name>/config.json, else
# SUPERTEAM_ROLE_<NAME> (name upper-cased, "-" -> "_"); if a pending,
# unowned, unblocked "Task N:" task tagged with that role exists, exits 2
# with 'claim "<subject>"' so the teammate keeps working. Never names
# another role's task. Fails open (exit 0) on anything unexpected.
#
# Four ways it stays quiet, so a teammate is never nudged in a loop:
#   - it owns an in_progress task (it already has work);
#   - the task was already offered to it: <tasks dir>/.idle/<teammate> lists
#     every task id this hook has offered that teammate, and a listed id is
#     not offered again however the tasks dir changes -- another seat's
#     TaskUpdate never re-offers a task;
#   - cooldown: that file's "last <epoch>" line is the time of the last offer,
#     and no offer of any task is made within ${SUPERTEAM_IDLE_COOLDOWN:-600}
#     seconds of it (a non-numeric value means 600). A claim resets it: the
#     "owned <ids>" line records the tasks the teammate owned at the last
#     offer, and a task it owns now that is not on that line is a claim since
#     the offer, so the window is cleared. The cooldown only blocks a second
#     offer that follows an offer with no claim in between; a seat that is
#     working is never idled by it;
#   - the task is declined: <tasks dir>/.declined/<teammate> holds one task
#     id per line, written by the teammate itself when it declines a task for
#     a stated reason. This hook only reads that file, never writes it, and a
#     listed id is never offered to that teammate again.
#
# Reassignment rule: an offer counts only while the task stays pending and
# unowned. Each run drops from the teammate's list any offered id whose task
# is now owned, not pending, or gone, so when a lead clears an owner to
# reassign a task, it can be offered again (after the cooldown). A teammate
# whose hook did not run while the task was owned is not re-offered it; the
# lead names the task to that teammate instead.

usage() {
    cat <<'EOF'
Usage: teammate-idle-claim
TeammateIdle hook: exits 2 with 'claim "<subject>"' when a pending, unowned,
unblocked "Task N:" task of the idle teammate's role exists; else exit 0.
Reads the TeammateIdle JSON payload from stdin.
Set SUPERTEAM_SKIP_VERIFY_GATE=1 to bypass this hook.
EOF
}

[ "${1:-}" = "--help" ] && { usage; exit 0; }
[ "${SUPERTEAM_SKIP_VERIFY_GATE:-}" = "1" ] && exit 0

input="$(cat 2>/dev/null || true)"

# Placeholder for an escaped quote (\") inside a JSON string value; see the
# same comment in hooks/task-completed-verify. BSD sed's BRE has no
# alternation, so [^"]* would truncate a value at its first escaped quote.
JSON_ESCQ="$(printf '\001')"

json_field() {
    printf '%s' "$1" | tr '\n' ' ' | sed "s/\\\\\"/$JSON_ESCQ/g" | \
        sed -n 's/.*"'"$2"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | \
        head -1
}

json_unescape() {
    printf '%s' "$1" | sed -e 's/\\n/\
/g' -e 's/\\"/"/g' -e 's/\\\\/\\/g' -e "s/$JSON_ESCQ/\"/g"
}

name="$(json_field "$input" "teammate_name")"
[ -n "$name" ] || exit 0

team="$(json_field "$input" "team_name")"
cfg="${SUPERTEAM_TEAMS_DIR:-$HOME/.claude/teams}/$team/config.json"

role=""
if [ -f "$cfg" ]; then
    # member object for this name -> its agentType; superteam:<role> -> <role>.
    # [^}]* keeps the match inside one member object.
    role="$(tr '\n' ' ' < "$cfg" | sed -n 's/.*"name"[[:space:]]*:[[:space:]]*"'"$name"'"[^}]*"agentType"[[:space:]]*:[[:space:]]*"superteam:\([a-z]*\)".*/\1/p' | head -1)"
fi
if [ -z "$role" ]; then
    envname="SUPERTEAM_ROLE_$(printf '%s' "$name" | tr 'a-z-' 'A-Z_')"
    role="$(printenv "$envname" 2>/dev/null || true)"
fi
case "$role" in
    implementer|writer|reviewer|integrator|researcher|skeptic) ;;
    *) exit 0 ;;
esac

dir="${SUPERTEAM_TASKS_DIR:-$HOME/.claude/tasks/${CLAUDE_CODE_TASK_LIST_ID:-$team}}"
[ -d "$dir" ] || exit 0

safe_name="$(printf '%s' "$name" | tr -c 'A-Za-z0-9_.-' '_')"

# Declined tasks: one task id per line in <tasks dir>/.declined/<teammate>.
# A teammate writes its own file when it declines a task for a stated reason;
# nothing here ever writes it. An id listed there is never offered again.
declined_file="$dir/.declined/$safe_name"

# Idle state: <tasks dir>/.idle/<teammate> holds a "last <epoch>" line, an
# "owned <ids>" line and one offered task id per line. A line of any other shape (the older
# "<id> <mtime>" pair) is read as its first field, an offered id; a
# non-numeric field is ignored, so the file never names a path.
mkdir -p "$dir/.idle" 2>/dev/null
idle_file="$dir/.idle/$safe_name"
# date +%s is the same under GNU and BSD date; no other date form is used.
now="$(date +%s 2>/dev/null)"
case "$now" in ''|*[!0-9]*) exit 0 ;; esac
cooldown="${SUPERTEAM_IDLE_COOLDOWN:-600}"
case "$cooldown" in ''|*[!0-9]*) cooldown=600 ;; esac

last_at=0
offered=""
owned_at_offer=""
if [ -f "$idle_file" ]; then
    while read -r first second rest; do
        [ -n "$first" ] || continue
        if [ "$first" = "last" ]; then
            case "$second" in ''|*[!0-9]*) ;; *) last_at="$second" ;; esac
        elif [ "$first" = "owned" ]; then
            owned_at_offer=" $second $rest "
        else
            case "$first" in *[!0-9]*) ;; *) offered="$offered $first" ;; esac
        fi
    done < "$idle_file"
fi

# Tasks this teammate owns now, whatever their status. One it did not own at
# the last offer is a claim since that offer: the cooldown window is cleared.
owned_now=""
claimed=0
for id in $(ls "$dir" 2>/dev/null | sed -n 's/^\([0-9][0-9]*\)\.json$/\1/p' | sort -n); do
    [ "$(json_field "$(tr '\n' ' ' < "$dir/$id.json")" "owner")" = "$name" ] || continue
    owned_now="$owned_now $id"
    case "$owned_at_offer" in *" $id "*) ;; *) claimed=1 ;; esac
done
[ "$claimed" -eq 0 ] || last_at=0

# An offer counts only while its task is still pending and unowned.
kept=""
for id in $offered; do
    f="$dir/$id.json"
    [ -f "$f" ] || continue
    t="$(tr '\n' ' ' < "$f")"
    [ "$(json_field "$t" "status")" = "pending" ] || continue
    [ -z "$(json_field "$t" "owner")" ] || continue
    kept="$kept $id"
done

write_idle_state() {
    local tmp="$idle_file.$$"
    {
        echo "last $last_at"
        echo "owned $owned_now"
        for id in $kept; do echo "$id"; done
    } > "$tmp" 2>/dev/null && mv -f "$tmp" "$idle_file" 2>/dev/null
    rm -f "$tmp" 2>/dev/null
    return 0
}
[ "$kept" = "$offered" ] && [ "$claimed" -eq 0 ] || write_idle_state

# A teammate already holding work is never nudged.
for f in "$dir"/*.json; do
    [ -f "$f" ] || continue
    t="$(tr '\n' ' ' < "$f")"
    [ "$(json_field "$t" "status")" = "in_progress" ] || continue
    [ "$(json_field "$t" "owner")" = "$name" ] || continue
    exit 0
done

# id -> 0 if that task file is completed (or missing)
is_done() {
    local f="$dir/$1.json"
    [ -f "$f" ] || return 0
    [ "$(json_field "$(tr '\n' ' ' < "$f")" "status")" = "completed" ]
}

# Task files are named by their id; lowest id wins. Sort the bare ids
# numerically -- sorting whole paths is lexicographic, which puts 10 before 2.
for id in $(ls "$dir" 2>/dev/null | sed -n 's/\.json$//p' | sort -n); do
    f="$dir/$id.json"
    [ -f "$f" ] || continue
    t="$(tr '\n' ' ' < "$f")"
    [ "$(json_field "$t" "status")" = "pending" ] || continue
    [ -z "$(json_field "$t" "owner")" ] || continue
    subj="$(json_unescape "$(json_field "$t" "subject")")"
    printf '%s' "$subj" | grep -qE "^Task [0-9]+:.*\[$role\]$" || continue
    if [ -f "$declined_file" ] && grep -qx "$id" "$declined_file"; then
        continue
    fi
    blocked=0
    for dep in $(printf '%s' "$t" | sed -n 's/.*"blockedBy"[[:space:]]*:[[:space:]]*\[\([^]]*\)\].*/\1/p' | tr -d '" ' | tr ',' ' '); do
        is_done "$dep" || { blocked=1; break; }
    done
    [ "$blocked" -eq 0 ] || continue
    # Already offered to this teammate: never again while it stays unowned.
    case " $kept " in *" $id "*) continue ;; esac
    # Cooldown: one offer per teammate per window, whatever the task.
    [ $((now - last_at)) -ge "$cooldown" ] || exit 0
    last_at="$now"
    kept="$kept $id"
    write_idle_state
    echo "claim \"$subj\" — TaskUpdate owner=$name status=in_progress, then do it." >&2
    exit 2
done

exit 0
