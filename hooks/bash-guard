#!/usr/bin/env bash
# PreToolUse hook for superteam. Denies three Bash commands that destroy work
# nobody asked to destroy:
#   tmux kill-server            - kills every team pane, not just this one
#   git checkout . / -- .       - discards the working tree
#   git reset --hard            - discards commits and the working tree
# Everything else exits 0 in silence. Fails open: a payload it cannot read is
# allowed. SUPERTEAM_SKIP_VERIFY_GATE=1 bypasses the whole guard.
#
# Known blind spots, stated plainly: this reads the command as text, it does
# not run it. A backtick does
# not count as command position either, so `git reset --hard` inside backticks
# runs unstopped - the cost of letting a review report quote the command it is
# reporting on. The mirror of that cost: a line of prose that BEGINS with one
# of these commands - a fenced code block line, a bullet starting with "git
# reset --hard discards..." - is denied, because a line start is command
# position and the hook cannot see it is inside a heredoc (leading whitespace
# does not help - it is skipped). Put a word, a bullet marker or a backtick in
# front of it. It is a guardrail against the common
# destructive typo, not a sandbox.
#
# Deny is returned as the PreToolUse permissionDecision payload on stdout with
# exit 0 (hooks.md, "PreToolUse decision control").

usage() {
    cat <<'EOF'
Usage: bash-guard
PreToolUse hook: denies destructive Bash commands - tmux kill-server,
git checkout . (or -- .), and git reset --hard. Reads the PreToolUse JSON
payload from stdin. Set SUPERTEAM_SKIP_VERIFY_GATE=1 to bypass this gate.
EOF
}

[ "${1:-}" = "--help" ] && { usage; exit 0; }
[ "${SUPERTEAM_SKIP_VERIFY_GATE:-}" = "1" ] && exit 0

input="$(cat 2>/dev/null || true)"
[ -n "$input" ] || exit 0

# Placeholder for an escaped quote (\") inside a JSON string value. BSD sed's
# BRE has no alternation, so [^"]* stops at the first escaped quote and
# truncates the value; swapping \" for a control character that cannot appear
# in JSON text keeps the whole value, and json_unescape puts it back.
JSON_ESCQ="$(printf '\001')"

json_field() {
    printf '%s' "$1" | tr '\n' ' ' | sed "s/\\\\\"/$JSON_ESCQ/g" | \
        sed -n 's/.*"'"$2"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | \
        head -1
}

json_unescape() {
    printf '%s' "$1" | sed -e 's/\\n/\
/g' -e 's/\\"/"/g' -e 's/\\\\/\\/g' -e "s/$JSON_ESCQ/\"/g"
}

[ "$(json_field "$input" "tool_name")" = "Bash" ] || exit 0

command_text="$(json_unescape "$(json_field "$input" "command")")"
[ -n "$command_text" ] || exit 0

# Escape a value for embedding in a JSON string. The reason quotes back paths
# taken from the command text, and a target carrying a double quote would
# otherwise emit malformed JSON - the one input class where the guard would
# fail open while believing it had denied.
json_escape() {
    printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

deny() {
    set -- "$(json_escape "$1 If you meant it, set SUPERTEAM_SKIP_VERIFY_GATE=1 to bypass this guard.")"
    cat <<EOF
{
  "hookSpecificOutput": {
    "hookEventName": "PreToolUse",
    "permissionDecision": "deny",
    "permissionDecisionReason": "$1"
  }
}
EOF
    exit 0
}

# Whitespace-normalised copy, so "git   reset --hard" matches the same word
# sequence. Newlines are kept: a newline is a command separator, and grep
# anchors ^ at every line, which is exactly the boundary we want.
norm="$(printf '%s' "$command_text" | tr '\t' ' ' | tr -s ' ')"

# A forbidden command only counts in command position: at the start of a line
# or right after a separator (; & && | || $(), past any leading whitespace and
# any sudo/env/command prefix. Quoting one in prose - a heredoc writing a
# report, an echo, a grep pattern - is writing about it, not running it. A
# backtick is deliberately not in the list: backtick-quoted prose in a Markdown
# heredoc is how reports get written, and a backtick-substituted destructive
# command is not the typo this guardrail exists for.
# The prefix group covers a bare sudo, env or command word and nothing else:
# "sudo -u alice", "nohup", "if ...; then", "xargs" all put the real command
# somewhere this pattern does not look.
cmdpos='(^|[;&|]|\$\()[[:space:]]*((sudo|env|command)[[:space:]]+)*'

if printf '%s' "$norm" | grep -qE "${cmdpos}tmux +kill-server([^[:alnum:]_.-]|\$)"; then
    deny "tmux kill-server tears down every teammate's pane, not just yours. Kill your own session by name instead."
fi

if printf '%s' "$norm" | grep -qE "${cmdpos}git +checkout +(-- +)?\.( |\$)"; then
    deny "git checkout . discards every uncommitted change in the worktree. Name the paths you mean, or stash first."
fi

if printf '%s' "$norm" | grep -qE "${cmdpos}git +reset +--hard([^[:alnum:]_.-]|\$)"; then
    deny "git reset --hard throws away commits and the working tree with no undo. Use git reset --soft or git revert."
fi

exit 0
